GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Correo verificado que recibirá los entrenamientos de desarrollo al PRIMER acceso.
